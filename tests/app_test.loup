@mode(host.dual)

# Unit tests for tree's whole command line (cli.app.run): exit statuses for
# help, version, real listings, an invalid path and too many parameters. These
# tests print the program's normal output and error messages; their folders go
# under build/tmp/.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with `loup-bootstrap test --no-parallel` (Stage0, source/ on LOUPPATH), one
# test per `func test_*()`. It is not part of the binary.

from debug.assert import (expectEq);
from io.fs import (createDir, removeDir, isDir);
from appinfo import (EXIT_OK, EXIT_FAILURE);
from cli.app import (run);

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
}

func test_help_succeeds(): void {
    expectEq(run(["/?"]), EXIT_OK, "/?");
}

func test_listing_succeeds(): void {
    let root = "build/tmp/app_tree";
    if (isDir(root)) {
        removeDir(root);
    }
    createDir(root + "/a/b");
    expectEq(run(["/F", root]), EXIT_OK, "a folder");
    expectEq(run([root + "/a/b", "/A"]), EXIT_OK, "no subfolders");
    removeDir(root);
}

func test_errors(): void {
    expectEq(run(["build/tmp/no_such_folder"]), EXIT_FAILURE, "invalid path");
    expectEq(run(["a", "b"]), EXIT_FAILURE, "too many parameters");
}
