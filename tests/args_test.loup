@mode(host.dual)

# Unit tests for tree's argument parsing (cli/args.loup): `/F` and `/A` in any
# case and with either prefix, paths that look like switches, help, version,
# and the `Too many parameters` error.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with `loup-bootstrap test --no-parallel` (Stage0, source/ on LOUPPATH), one
# test per `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from cli.args import (parse_args, tree_switches, msg_too_many);

func same(got: string, want: string, what: string): void {
    expect(got == want, what + ": got '" + got + "', want '" + want + "'");
}

func test_declared_switches(): void {
    expectEq(tree_switches().len(), 2, "F A");
}

func test_defaults(): void {
    let none: list[string] = [];
    let opts = parse_args(none).unwrap();
    expect(!opts.files and !opts.ascii and !opts.help and !opts.version, "no switches");
    same(opts.path, "", "current directory");
}

func test_switches_any_case_and_prefix(): void {
    let opts = parse_args(["/f", "-A", "src"]).unwrap();
    expect(opts.files and opts.ascii, "/f -A");
    same(opts.path, "src", "path");
    let joined = parse_args(["/F/A"]).unwrap();
    expect(joined.files and joined.ascii, "/F/A");
    expect(parse_args(["/F", "/F"]).unwrap().files, "repeated switch");
}

func test_paths(): void {
    same(parse_args(["/usr/share", "/A"]).unwrap().path, "/usr/share", "an undeclared /X is a path");
    same(parse_args(["docs\\img"]).unwrap().path, "docs\\img", "backslashes kept as typed");
    same(parse_args(["--", "/F"]).unwrap().path, "/F", "/F after -- is a path");
    expect(!parse_args(["--", "/F"]).unwrap().files, "and not a switch");
}

func test_help_and_version(): void {
    expect(parse_args(["/?"]).unwrap().help, "/?");
    expect(parse_args(["a", "b", "-?"]).unwrap().help, "help wins over two paths");
    expect(parse_args(["--help"]).unwrap().help, "--help");
    expect(parse_args(["--version"]).unwrap().version, "--version");
}

func test_too_many_parameters(): void {
    same(parse_args(["a", "b"]).unwrap_err(), "Too many parameters - b", "two paths");
    same(parse_args(["a", "/F", "b", "c"]).unwrap_err(), msg_too_many("b"), "the second one is named");
}
