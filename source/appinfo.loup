@mode(host.dual)

# Application identity of tree: name, version, one-line summary and exit
# statuses. Keep APP_NAME and APP_VERSION in step with `name` and `version` in
# package.lppkg.
#
# Runtime: host.dual. Compiled into the native binary build/tree by
# `make build`; `loup run source/main.loup` interprets the same code.

pub const APP_NAME: string = "tree";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Draw the folder structure of a path (a Loup recreation of the Windows tree command).";

# Exit statuses returned by main(), as cmd's ERRORLEVEL: 0 for a listing,
# 1 for an invalid path or too many parameters.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
