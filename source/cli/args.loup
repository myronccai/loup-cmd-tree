@mode(host.dual)

# Command-line parsing for tree, with the shared Windows switch parser
# (win/switches.loup). tree has two switches, /F and /A; a `/X` that is not
# one of them is a path (so `/usr/share` stays a path), and at most one path
# may be given.
#
# Runtime: host.dual. Compiled into the native binary build/tree by
# `make build`; `loup run source/main.loup` interprets the same code.

from win.switches import (SwitchSpec, flag, parse_switches, has_switch, switch_error_message);

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub files: bool;      # /F: list the files in each folder too
    pub ascii: bool;      # /A: ASCII instead of box-drawing characters
    pub path: string;     # the folder to start from; "" = the current directory
}

# The switches tree declares.
pub func tree_switches(): list[SwitchSpec] {
    return [flag("F"), flag("A")];
}

# Options are built here only: a struct constructed in several modules is
# laid out differently by native builds.
# Callers name the fields they set; the others keep their defaults.
func make_options(help: bool = false, version: bool = false, files: bool = false, ascii: bool = false,
    path: string = ""): Options {
    return Options(help = help, version = version, files = files, ascii = ascii, path = path);
}

pub func msg_too_many(arg: string): string {
    return "Too many parameters - " + arg;
}

# The statement form of `match` (arms that return) is deliberate: a match
# expression whose arms build new values returns freed memory natively.
pub func parse_args(argv: list[string]): Result[Options, string] {
    let parsed = match parse_switches(argv, tree_switches()) {
        Ok(p) => p,
        Err(e) => {
            return Err(switch_error_message(e));
        },
    };
    if (parsed.help or parsed.version) {
        return Ok(make_options(help = parsed.help, version = parsed.version));
    }
    if (parsed.operands.len() > 1) {
        return Err(msg_too_many(parsed.operands[1]));
    }
    let path = if (parsed.operands.len() == 1) { parsed.operands[0] } else { "" };
    return Ok(make_options(files = has_switch(parsed, "F"), ascii = has_switch(parsed, "A"), path = path));
}
