@mode(host.dual)

# Help and version text of tree: what `tree /?` prints (a short summary of
# this recreation's syntax and switches) and the series' `--version` line.
#
# Runtime: host.dual. Compiled into the native binary build/tree by
# `make build`; `loup run source/main.loup` interprets the same code.

from appinfo import (APP_NAME, APP_VERSION);

# The text of `tree /?`: a short summary of this recreation's syntax and
# switches.
pub func usage(): string {
    let lines = [
        "Draw the folders below a directory as a tree.",
        "",
        "TREE [path] [/F] [/A]",
        "",
        "  path  Where the tree starts (default: the current directory).",
        "  /F    Show the files of every folder too.",
        "  /A    Draw the lines with ASCII characters (+ \\ | -) instead of",
        "        box-drawing characters.",
        "  /?    Show this summary.",
    ];
    return lines.join("\n");
}

pub func version_line(): string {
    return i"{$ APP_NAME $} (loup-cmd-{$ APP_NAME $}) {$ APP_VERSION $}";
}
